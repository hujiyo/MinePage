# 本地开发用的环境变量模板
#
# 复制成 .env 再填真实值：cp .env.example .env
# **不要把 .env 提交到 git**（已在 .gitignore 里）
#
# 生产环境不读 .env，用 systemd 的 EnvironmentFile（/etc/minepage.env）。

# ---- 模型（agent 用）----
# 网关地址（openai-completions 协议，要带 /v1）
LLM_BASE_URL=
# Key：在网关控制台生成，只落本地
LLM_API_KEY=
# 默认模型 id
LLM_MODEL=deepseek-v4.1-flash

# 默认用哪条配置（fast / smart / coder / local）
AGENT_DEFAULT_MODEL=fast

# 一轮最多几步、整轮超时、单次请求超时（毫秒）
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_MS=110000
# 网络不稳时把单次超时调小：失败得早一点，用户不用干等
AGENT_REQUEST_TIMEOUT_MS=60000

# 每用户每天最多跑几轮
AGENT_DAILY_TURNS=100

# ---- 数据库 ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=minepage
MYSQL_PASSWORD=
MYSQL_DATABASE=minepage
