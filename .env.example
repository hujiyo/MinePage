# 本地开发用的环境变量模板
#
# 复制成 .env 再填真实值：cp .env.example .env
# **不要把 .env 提交到 git**（已在 .gitignore 里）
#
# 生产环境不读 .env，用 systemd 的 EnvironmentFile（/etc/minepage.env）。

# ---- 模型（agent 用）----
# 注意：模型的增删改现在在「管理后台 → 模型配置」里做，结果存在数据库。
# 下面的环境变量只是「种子」和「兜底」，正常配置不需要动它们。

# 网关地址：内置模型种子会用这个地址填 base_url（openai-completions 协议，要带 /v1）
LLM_BASE_URL=
# Key：没在后台填 key 的内置模型会用这个兜底；在后台填过就以库里的为准
LLM_API_KEY=
# 默认模型 id（后台没勾「默认」时才用这个）
LLM_MODEL=deepseek-v4.1-flash

# 加密主密钥：后台填的 API Key 用 AES-256-GCM 加密后入库，密钥就是这一串。
#   - 不配的话后台保存 key 会失败，只能用上面的 LLM_API_KEY 兜底
#   - 换掉这串会导致库里已有的 key 全部解不开（界面上会显示「密钥解不开」）
#   - 生成一串：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MODEL_SECRET=

# 默认用哪条配置（fast / smart / coder / local，都是 deepseek 的旧别名）
AGENT_DEFAULT_MODEL=fast

# 一轮最多几步、整轮超时、单次请求超时（毫秒）
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_MS=110000
# 网络不稳时把单次超时调小：失败得早一点，用户不用干等
AGENT_REQUEST_TIMEOUT_MS=60000

# 每用户每天最多跑几轮
AGENT_DAILY_TURNS=100

# ---- 数据库 ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=minepage
MYSQL_PASSWORD=
MYSQL_DATABASE=minepage
