# 复制成 .env 再改。这个文件是模板，不含真实密码。

# ---- 数据库 ----
# 开发：不设这一项，默认用 SQLite（./data/minepage.db），不用装任何数据库服务
# 部署：PostgreSQL
# DATABASE_URL=postgresql+psycopg://minepage:改成你的密码@db:5432/minepage

# docker-compose 里 postgres 的密码（必须和上面 DATABASE_URL 里的一致）
POSTGRES_PASSWORD=change-me

# ---- HTTP ----
HOST=127.0.0.1
PORT=3000

# ---- 会话 Cookie ----
# 全站 HTTPS 之后设成 1，Cookie 会带 Secure；非 HTTPS 环境设 1 会导致登录不上
COOKIE_SECURE=0

# ---- 邮箱验证码 ----
# 不配 SMTP_HOST 就走开发模式：整封信（含验证码）打印到服务器控制台
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_SECURE=1

# ---- 管理员种子账号（首次启动时创建，只在库里没有管理员时生效）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123
ADMIN_EMAIL=admin@minepage.local
